    Dim elemNode: Set elemNode = xmlDoc.createElement("tmp")
    elemNode.dataType = "bin.base64"
    elemNode.text = fileData
    fileContent = elemNode.nodeTypedValue
    
    ' Write binary data to file
    Dim binaryStream: Set binaryStream = CreateObject("ADODB.Stream")
    binaryStream.Type = 1 ' adTypeBinary
    binaryStream.Open
    binaryStream.Write fileContent
    binaryStream.SaveToFile filePath, 2 ' adSaveCreateOverWrite
    binaryStream.Close
